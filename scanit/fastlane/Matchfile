# Signing reuses Khepri's match storage: NorthAIProject/north-ios-certificates.
#
# The team (84X9WYBF36) is at Apple's limit of three distribution certificates, so ScanIt does
# not mint one. That repo holds the existing certificate BC73LRR48W (imported by Khepri with
# `fastlane match import`); ScanIt only adds its own App Store profiles next to Khepri's.
#
#   - MATCH_PASSWORD is Khepri's match password.
#   - MATCH_GIT_BASIC_AUTHORIZATION = base64 "x-access-token:<PAT>", PAT able to read
#     NorthAIProject/north-ios-certificates (read and write for `seed_signing`).
#   - BC73LRR48W expires 2027-09-23; when Khepri renews it, ScanIt re-runs `seed_signing`.
git_url("https://github.com/NorthAIProject/north-ios-certificates.git")
git_branch("main")
storage_mode("git")
type("appstore")
# Prod App Store app + side-by-side TestFlight beta app (separate App Store Connect apps).
# Each app embeds the widget extension that draws the trip Live Activity (BACKLOG LIVE-001), and
# an extension needs its own App ID and profile. After adding one here, run `seed_signing` once.
app_identifier([
  "com.fernandocorreia.scanit",
  "com.fernandocorreia.scanit.widgets",
  "com.fernandocorreia.scanit.beta",
  "com.fernandocorreia.scanit.beta.widgets"
])
team_id("84X9WYBF36")
