# ScanIt iOS lanes, adapted from Norviq's (norviq-ios/financeplan/fastlane/Fastfile).
#
#   beta          CI on every green main → "ScanIt Beta" (com.fernandocorreia.scanit.beta) on TestFlight
#   seed_signing  one-time: add ScanIt's App Store profiles to the shared match repo
#   release       manual: Release build → production ScanItNow app (its TestFlight)
#   submit_status manual, read only: App Store versions, review submissions, newest builds
#   submit        manual: attach SUBMIT_BUILD (or the newest upload) to the editable version, submit
#
# Env: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8 (base64 .p8), MATCH_PASSWORD, MATCH_GIT_BASIC_AUTHORIZATION.

require "base64"
require "tmpdir"

default_platform(:ios)

PROJECT = "scanit.xcodeproj"
SCHEME = "scanit"
TARGET = "scanit"
# The widget extension (trip Live Activity). Its bundle ID is the app's plus this suffix.
WIDGETS_TARGET = "scanitWidgets"
WIDGETS_SUFFIX = ".widgets"
BUNDLE_ID = "com.fernandocorreia.scanit"
BETA_BUNDLE_ID = "com.fernandocorreia.scanit.beta"
TEAM_ID = "84X9WYBF36"

platform :ios do
  desc "Build the Beta configuration and upload it to the ScanIt Beta app on TestFlight"
  lane :beta do
    api_key = asc_api_key
    setup_ci if is_ci
    match(type: "appstore", readonly: true, api_key: api_key)
    prepare_signing(bundle_id: BETA_BUNDLE_ID, config: "Beta")
    bump_build_number(api_key: api_key, bundle_id: BETA_BUNDLE_ID)

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Beta",
      export_method: "app-store",
      output_directory: "fastlane/build"
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: BETA_BUNDLE_ID,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Build the Release configuration and upload it to the production ScanItNow app"
  desc "Lands in ScanItNow → TestFlight; submit it for review from App Store Connect (docs/release.md)."
  lane :release do
    api_key = asc_api_key
    setup_ci if is_ci
    match(type: "appstore", readonly: true, api_key: api_key)
    prepare_signing(bundle_id: BUNDLE_ID, config: "Release")
    bump_build_number(api_key: api_key, bundle_id: BUNDLE_ID)

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "fastlane/build"
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Read only: the ScanItNow versions, review submissions and newest builds"
  lane :submit_status do
    run_asc_submit("--status")
  end

  desc "Attach a processed build to the editable version and submit it for App Review"
  desc "SUBMIT_BUILD picks the build number; without it, the newest upload (waits for processing)."
  lane :submit do
    build = ENV["SUBMIT_BUILD"].to_s.strip
    run_asc_submit(*(build.empty? ? [] : ["--build", build]))
  end

  desc "One-time (re-runnable): create ScanIt's App IDs, then its App Store profiles in the shared match repo"
  desc "Reuses the team's existing Apple Distribution certificate; needs write access to the repo."
  lane :seed_signing do
    api_key = asc_api_key
    setup_ci if is_ci
    ensure_bundle_ids(api_key: api_key)
    match(type: "appstore", readonly: false, api_key: api_key)
  end

  # ---- helpers ----

  # match only makes profiles for App IDs that already exist. The widget extensions
  # (LIVE-001) are new, so create whatever the Matchfile lists and the portal lacks. Plain
  # App IDs: a Live Activity needs no capability.
  private_lane :ensure_bundle_ids do |options|
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: options[:api_key])
    [BUNDLE_ID, BUNDLE_ID + WIDGETS_SUFFIX, BETA_BUNDLE_ID, BETA_BUNDLE_ID + WIDGETS_SUFFIX].each do |identifier|
      # The identifier filter also matches longer IDs, so compare exactly.
      existing = Spaceship::ConnectAPI::BundleId.all(filter: { identifier: identifier })
      next if existing.any? { |bundle_id| bundle_id.identifier == identifier }

      name = identifier.end_with?(WIDGETS_SUFFIX) ? "ScanIt Widgets" : "ScanIt"
      name += " Beta" if identifier.start_with?(BETA_BUNDLE_ID)
      Spaceship::ConnectAPI::BundleId.create(
        name: name,
        platform: "IOS",
        identifier: identifier
      )
      UI.success("Created App ID #{identifier}")
    end
  end

  # asc_submit.rb reads the .p8 from a file: write it from the secret, and delete it afterwards.
  def run_asc_submit(*args)
    Dir.mktmpdir do |dir|
      key_path = File.join(dir, "AuthKey.p8")
      File.write(key_path, Base64.decode64(ENV.fetch("ASC_KEY_P8")))
      File.chmod(0o600, key_path)
      ENV["ASC_KEY_PATH"] = key_path
      sh("ruby", File.join(__dir__, "asc_submit.rb"), *args)
    ensure
      ENV.delete("ASC_KEY_PATH")
    end
  end

  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: true
    )
  end

  # The project uses Xcode-managed signing for local development; CI pins the match profile.
  private_lane :prepare_signing do |options|
    { TARGET => options[:bundle_id], WIDGETS_TARGET => options[:bundle_id] + WIDGETS_SUFFIX }.each do |target, bundle_id|
      update_code_signing_settings(
        path: PROJECT,
        use_automatic_signing: false,
        team_id: TEAM_ID,
        code_sign_identity: "Apple Distribution",
        profile_name: "match AppStore #{bundle_id}",
        targets: [target],
        build_configurations: [options[:config]]
      )
    end
  end

  # CFBundleVersion must exceed every earlier upload of this app, so read them all from App Store
  # Connect instead of trusting the project file.
  private_lane :bump_build_number do |options|
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: options[:api_key])
    app = Spaceship::ConnectAPI::App.find(options[:bundle_id])
    UI.user_error!("Create #{options[:bundle_id]} in App Store Connect first (docs/release.md)") unless app

    build_numbers = app.get_builds.map { |build| Integer(build.version, exception: false) }.compact
    increment_build_number(build_number: (build_numbers.max || 0) + 1, xcodeproj: PROJECT)
  end
end
