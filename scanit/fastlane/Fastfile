# ScanIt iOS lanes, adapted from Norviq's (norviq-ios/financeplan/fastlane/Fastfile).
#
#   beta          CI on every green main → "ScanIt Beta" (com.fernandocorreia.scanit.beta) on TestFlight
#   seed_signing  one-time: add ScanIt's App Store profiles to the shared match repo
#   release       manual: Release build → production ScanItNow app; submit from App Store Connect
#
# Env: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8 (base64 .p8), MATCH_PASSWORD, MATCH_GIT_BASIC_AUTHORIZATION.

default_platform(:ios)

PROJECT = "scanit.xcodeproj"
SCHEME = "scanit"
TARGET = "scanit"
# The widget extension (trip Live Activity). Its bundle ID is the app's plus this suffix.
WIDGETS_TARGET = "scanitWidgets"
WIDGETS_SUFFIX = ".widgets"
BUNDLE_ID = "com.fernandocorreia.scanit"
BETA_BUNDLE_ID = "com.fernandocorreia.scanit.beta"
TEAM_ID = "84X9WYBF36"

platform :ios do
  desc "Build the Beta configuration and upload it to the ScanIt Beta app on TestFlight"
  lane :beta do
    api_key = asc_api_key
    setup_ci if is_ci
    match(type: "appstore", readonly: true, api_key: api_key)
    prepare_signing(bundle_id: BETA_BUNDLE_ID, config: "Beta")
    bump_build_number(api_key: api_key, bundle_id: BETA_BUNDLE_ID)

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Beta",
      export_method: "app-store",
      output_directory: "fastlane/build"
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: BETA_BUNDLE_ID,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Build the Release configuration and upload it to the production ScanItNow app"
  desc "Lands in ScanItNow → TestFlight; submit it for review from App Store Connect (docs/release.md)."
  lane :release do
    api_key = asc_api_key
    setup_ci if is_ci
    match(type: "appstore", readonly: true, api_key: api_key)
    prepare_signing(bundle_id: BUNDLE_ID, config: "Release")
    bump_build_number(api_key: api_key, bundle_id: BUNDLE_ID)

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "fastlane/build"
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "One-time (re-runnable): create ScanIt's App Store profiles in the shared match repo"
  desc "Reuses the team's existing Apple Distribution certificate; needs write access to the repo."
  lane :seed_signing do
    api_key = asc_api_key
    setup_ci if is_ci
    match(type: "appstore", readonly: false, api_key: api_key)
  end

  # ---- helpers ----

  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: true
    )
  end

  # The project uses Xcode-managed signing for local development; CI pins the match profile.
  private_lane :prepare_signing do |options|
    { TARGET => options[:bundle_id], WIDGETS_TARGET => options[:bundle_id] + WIDGETS_SUFFIX }.each do |target, bundle_id|
      update_code_signing_settings(
        path: PROJECT,
        use_automatic_signing: false,
        team_id: TEAM_ID,
        code_sign_identity: "Apple Distribution",
        profile_name: "match AppStore #{bundle_id}",
        targets: [target],
        build_configurations: [options[:config]]
      )
    end
  end

  # CFBundleVersion must exceed every earlier upload of this app, so read them all from App Store
  # Connect instead of trusting the project file.
  private_lane :bump_build_number do |options|
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: options[:api_key])
    app = Spaceship::ConnectAPI::App.find(options[:bundle_id])
    UI.user_error!("Create #{options[:bundle_id]} in App Store Connect first (docs/release.md)") unless app

    build_numbers = app.get_builds.map { |build| Integer(build.version, exception: false) }.compact
    increment_build_number(build_number: (build_numbers.max || 0) + 1, xcodeproj: PROJECT)
  end
end
