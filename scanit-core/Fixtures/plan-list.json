          { "text": "frúta ", "code": null, "quantity": 1, "inPantry": false }
        ] },
        { "meal": "Sopa", "mealServings": 4, "servings": 1, "ingredients": [
          { "text": "Cenouras", "code": null, "quantity": 2, "inPantry": false },
