          { "text": "Pão de forma", "code": "04006381333931", "quantity": 1, "inPantry": false },
          { "text": "Fruta", "code": null, "quantity": 2, "inPantry": false }
        ] },
        { "meal": "Tosta mista", "mealServings": 2, "servings": 2, "ingredients": [
