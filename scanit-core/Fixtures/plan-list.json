          { "text": "Leite", "code": "05601234567892", "quantity": 1, "inPantry": false }
        ] },
        { "meal": "Bacalhau", "mealServings": 2, "servings": 0, "ingredients": [
          { "text": "Bacalhau", "code": null, "quantity": 1, "inPantry": false }
        ] }
      ],
      "expected": [
        { "key": "code:05601234567892", "text": "Leite meio gordo", "packs": 2, "meals": ["Pequeno-almoço", "Sopa"], "inPantry": false },
        { "key": "code:04006381333931", "text": "Pão de forma", "packs": 3, "meals": ["Pequeno-almoço", "Tosta mista"], "inPantry": false },
        { "key": "text:fruta", "text": "Fruta", "packs": 4, "meals": ["Pequeno-almoço", "Tosta mista"], "inPantry": false },
        { "key": "text:queijo", "text": "Queijo", "packs": 1, "meals": ["Tosta mista"], "inPantry": false },
        { "key": "text:cenouras", "text": "Cenouras", "packs": 1, "meals": ["Sopa"], "inPantry": false },
        { "key": "text:azeite", "text": "Azeite", "packs": 1, "meals": ["Sopa"], "inPantry": true }
      ]
    },
    {
      "name": "three thirds make one pack",
      "meals": [
        { "meal": "Sopa", "mealServings": 3, "servings": 1, "ingredients": [{ "text": "Leite", "code": "05601234567892", "quantity": 1, "inPantry": false }] },
        { "meal": "Sopa", "mealServings": 3, "servings": 1, "ingredients": [{ "text": "Leite", "code": "05601234567892", "quantity": 1, "inPantry": false }] },
        { "meal": "Sopa", "mealServings": 3, "servings": 1, "ingredients": [{ "text": "Leite", "code": "05601234567892", "quantity": 1, "inPantry": false }] }
      ],
      "expected": [
        { "key": "code:05601234567892", "text": "Leite", "packs": 1, "meals": ["Sopa"], "inPantry": false }
